##############################
# Dotfiles
##############################
source ~/.zsh_environment


##############################
# Homebrew
##############################
# Apple Silicon, Intel Mac, then Linuxbrew. Skipped where brew isn't installed.
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [[ -x $brew_bin ]] && eval "$($brew_bin shellenv)" && break
done
unset brew_bin
# Before Oh My Zsh, whose compinit then picks up brew's completions. A second
# compinit of our own would abort on any folder it thinks is insecure.
[[ -n $HOMEBREW_PREFIX ]] && FPATH="$HOMEBREW_PREFIX/share/zsh/site-functions:${FPATH}"


##############################
# Oh My Zsh
##############################
CASE_SENSITIVE="true"
COMPLETION_WAITING_DOTS="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"
ENABLE_CORRECTION="true"
HYPHEN_INSENSITIVE="true"
UPDATE_ZSH_DAYS=7
ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000000
SAVEHIST=10000000
HIST_STAMPS="mm/dd/yyyy"

plugins=(docker docker-compose git gitfast kubectl kubectx kube-ps1)
source $ZSH/oh-my-zsh.sh

# After Oh My Zsh, which defines its own ls alias.
source ~/.zsh_aliases
source ~/.zsh_functions


##############################
# Plugins
##############################
# Homebrew keeps them under its prefix, distro packages under /usr/share.
source_first() {
  local f
  for f in "$@"; do
    [[ -r $f ]] && source "$f" && return
  done
}
source_first "$HOMEBREW_PREFIX/share/kube-ps1.sh" /usr/share/kube-ps1/kube-ps1.sh
source_first "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# Keeps the prompt working where kube-ps1 isn't installed.
(( $+functions[kube_ps1] )) || kube_ps1() { }


##############################
# Autocomplete
##############################
zstyle ':completion:*:*:docker:*' option-stacking yes   # Docker
zstyle ':completion:*:*:docker-*:*' option-stacking yes # Docker
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'  # Case-insensitive tab

# CLIs that ship their own completions instead of a site-functions file
autoload -Uz bashcompinit && bashcompinit
(( $+commands[kubectl] )) && source <(kubectl completion zsh)
(( $+commands[kubectl-argo-rollouts] )) && source <(kubectl-argo-rollouts completion zsh)
(( $+commands[aws_completer] )) && complete -C aws_completer aws


##############################
# Prompt
##############################
autoload -Uz vcs_info
setopt prompt_subst

zstyle ':vcs_info:*' stagedstr 'S'
zstyle ':vcs_info:*' unstagedstr 'D'
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' actionformats '%F{251}[%F{203}%b%F{251}|%F{2}%a%F{3}]%f '
zstyle ':vcs_info:*' formats \
      '%F{white}[%F{cyan}%b%F{white}] %F{2}%c%F{3}%u%f'
zstyle ':vcs_info:git*+set-message:*' hooks git-untracked
zstyle ':vcs_info:*' enable git
+vi-git-untracked() {
  if [[ $(git rev-parse --is-inside-work-tree 2> /dev/null) == 'true' ]] && \
        [[ $(git ls-files --other --directory --exclude-standard | sed q | wc -l | tr -d ' ') == 1 ]] ; then
    hook_com[unstaged]+='%F{1}U%f'
fi
}

precmd () { vcs_info }

export PS1='
%F{magenta}%BDir: %d ${vcs_info_msg_0_}
%F{cyan}%BCluster: $(kube_ps1)
%F{blue}%BUsr: %n - %B%w, %@%f >%b%f '


##############################
# Syntax Highlighting
##############################
# Must be sourced last so it wraps every widget defined above.
source_first "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
