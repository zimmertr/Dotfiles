# Claude Code through LiteLLM, so Claude can hand work to local models as subagents.
claude-hybrid() {
  ANTHROPIC_BASE_URL=http://192.168.40.142:4000 \
  ANTHROPIC_CUSTOM_HEADERS="x-litellm-api-key: Bearer $(jq -r '.litellm.env.LITELLM_MASTER_KEY' ~/.claude/secrets.json)" \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144 \
  claude "$@"
}
