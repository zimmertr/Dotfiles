##############################
# Git
##############################
gitdb() {
  git checkout "$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5)"
}


##############################
# Kubernetes
##############################
# Kustomize
kget() {
    if [ "$1" = "kind" ]
    then
        kustomize build --enable-helm --load-restrictor=LoadRestrictionsNone "$2" | yq e "select(.kind == \"$3\")" -
    elif [ "$1" = "name" ]
    then
        kustomize build --enable-helm --load-restrictor=LoadRestrictionsNone "$2" | yq e "select(.metadata.name == \"$3\")" -
    else
        kustomize build --enable-helm --load-restrictor=LoadRestrictionsNone "$1"
    fi
}

kwatch() {
    if [ $1 = "kind" ]
    then
        watch -n .1 -d "kustomize build --enable-helm --load-restrictor=LoadRestrictionsNone $2 | yq e 'select(.kind == \"$3\")' -"
    elif [ $1 = "name" ]
    then
        watch -n .1 -d "kustomize build --enable-helm --load-restrictor=LoadRestrictionsNone $2 | yq e 'select(.metadata.name == \"$3\")' -"
    else
        watch -n .1 -d "kustomize build --enable-helm --load-restrictor=LoadRestrictionsNone $1"
    fi
}


